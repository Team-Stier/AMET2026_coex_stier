Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: Metric Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Four-Line Fence Reference
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/fence
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Current Pose Comparison
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/poses
    - Class: rviz_default_plugins/Path
      Color: 255; 31; 31
      Enabled: true
      Line Style: Billboards
      Line Width: 0.060
      Name: ODOM - fused EKF
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/raw_path
    - Class: rviz_default_plugins/Path
      Color: 255; 158; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.025
      Name: ODOM LASER - lidar only
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/laser_path
    - Class: rviz_default_plugins/Path
      Color: 31; 255; 31
      Enabled: true
      Line Style: Billboards
      Line Width: 0.100
      Name: SIMULATOR TRUTH
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/truth_path
    - Class: rviz_default_plugins/Path
      Color: 0; 230; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.035
      Name: FENCE CORRECTED
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/corrected_path
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Full Fence Map
      Scale: 75
      Target Frame: map
      X: 6
      Y: 3.5
Window Geometry:
  Height: 900
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 1400
