Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: Metric Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Calibrated Color Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/map
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Raw Corrected Truth
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/poses
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Observed Lane Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/observed_lane
    - Class: rviz_default_plugins/Path
      Color: 255; 40; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Raw Odom Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/raw_path
    - Class: rviz_default_plugins/Path
      Color: 0; 230; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Corrected Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/corrected_path
    - Class: rviz_default_plugins/Path
      Color: 30; 255; 30
      Enabled: true
      Line Style: Lines
      Line Width: 0.03
      Name: Simulator Truth Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/truth_path
    - Class: rviz_default_plugins/Path
      Color: 255; 220; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Waypoint Reference Path
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calibration/rviz/waypoint_path
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Full Map
      Scale: 85
      Target Frame: map
      X: 6
      Y: 3.5
Window Geometry:
  Height: 850
  Width: 1280
